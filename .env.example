# ==============================================================
# AutoApply AI — Environment Configuration (.env.example)
# Copy this file to backend/.env (or set in Railway/Docker)
# ==============================================================

# --- Core Server ---
NODE_ENV=development
PORT=5000
DB_PATH=./data/jobs.db
JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-characters
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# --- AI Engine (Required for Resume Tailoring, Matching & Cover Letters) ---
GEMINI_API_KEY=your-google-gemini-api-key
# Optional fallback:
# OPENAI_API_KEY=

# --- Hourly Autonomous Scheduler ---
ENABLE_SCHEDULED_JOBS=true
DISCOVERY_CRON_SCHEDULE=0 * * * *

# --- Email Delivery (Pick ONE: Brevo, SMTP, or Resend) ---
# Option 1: Brevo HTTP API (recommended for cloud hosts like Railway)
BREVO_API_KEY=
EMAIL_FROM=noreply@yourdomain.com

# Option 2: Standard SMTP (e.g., Gmail App Password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Option 3: Resend API
# RESEND_API_KEY=

# --- Optional Extra Job Portals (Greenhouse, Ashby, Lever, Himalayas, Remotive, RemoteOK, Jobicy & Arbeitnow work out-of-the-box with zero keys!) ---
RAPIDAPI_KEY=
JOOBLE_API_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# --- Optional Server-Wide Default WhatsApp (Users can also configure per-account in Settings) ---
# WHATSAPP_PHONE=+919876543210
# CALLMEBOT_API_KEY=
# WHATSAPP_CLOUD_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# --- Optional Server-Wide IMAP Company Reply Tracker (Users can also configure per-account in Settings) ---
# IMAP_HOST=imap.gmail.com
# IMAP_EMAIL=
# IMAP_PASSWORD=
